# What stays off GitHub: pitch materials, personal files, caches and rendered media.

# Pitch materials (video, script, graphics) stay local
presentation/

# Original team photos and personal notes
/*.png
/*.jpg
/*.jpeg
/*.txt

# Build helpers and scratch output
prototype/
__pycache__/
*.pyc
.venv/

# Local data caches (the app only ships what it needs in app/data and app/fields)
/data/
.env

# Editing projects, audio and rendered video
*.mp4
*.m4a
*.mp3
*.prproj
*.prin
Adobe Premiere Pro*/
graphify-out/

